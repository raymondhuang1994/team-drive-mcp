{
  "name": "team-drive-mcp",
  "version": "0.1.0",
  "description": "Local-first, evidence-aware team document reader with MCP tools and an agent skill",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js --config examples/config.sample.json",
