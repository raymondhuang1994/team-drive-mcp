    "test": "node scripts/test.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "check:public": "python3 scripts/check_public.py",
    "install:skill": "node scripts/install-skill.mjs"
  },
  "dependencies": { "@modelcontextprotocol/server": "2.3.1", "zod": "4.3.6" },
  "devDependencies": { "@modelcontextprotocol/client": "2.3.1", "@types/node": "^22.0.0", "typescript": "^5.9.0" }
}
